
@page "/settings"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Settings - StockFlow</PageTitle>

<h3>Settings</h3>

<p>Choose your preferred appearance for StockFlow.</p>

<div class="card p-4">
    <h5>Appearance</h5>

    <p>Current Theme: @currentTheme</p>

    <button class="btn btn-outline-primary me-2"
            @onclick="SetLightTheme">
        Light Mode
    </button>

    <button class="btn btn-outline-secondary"
            @onclick="SetDarkTheme">
        Dark Mode
    </button>
</div>

@code {
    private string currentTheme = "Light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentTheme = await JS.InvokeAsync<string>(
                "stockFlowTheme.getTheme");

            StateHasChanged();
        }
    }

    private async Task SetLightTheme()
    {
        await JS.InvokeVoidAsync("stockFlowTheme.setTheme", "light");
        currentTheme = "Light";
    }

    private async Task SetDarkTheme()
    {
        await JS.InvokeVoidAsync("stockFlowTheme.setTheme", "dark");
        currentTheme = "Dark";
    }
}
